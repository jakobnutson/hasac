---
import BaseHead from '../hasac/components/BaseHead.astro';
import Footer from '../hasac/components/sections/Footer.astro';
import Header from '../hasac/components/sections/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../hasac/consts';
import HeroSection from '../hasac/components/sections/HeroSection.astro';
import SkillsSection from '../hasac/components/sections/SkillsSection.astro';
import { skills } from '../hasac/data/skills';
import WorkExperience from '../hasac/components/sections/WorkExperience.astro';
import { work } from '../hasac/data/work';
import Studies from '../hasac/components/sections/Studies.astro';
import { studies } from '../hasac/data/studies';
import Carousel from '../hasac/components/ui/carousel/Carousel.astro';
import { logos } from '../hasac/data/logos';
import ArrowSeparator from '../hasac/components/ui/separator/ArrowSeparator.astro'
import GlowLineSeparator from '../hasac/components/ui/separator/GlowLineSeparator.astro'

// Logos
import astroLogo from '../hasac/assets/logos/Astro-logo.svg';
import googleAdsLogo from '../hasac/assets/logos/GoogleAds-logo.svg';
import posthogLogo from '../hasac/assets/logos/posthog-logo.svg';
import notionLogo from '../hasac/assets/logos/Notion-logo.svg';
import figmaLogo from '../hasac/assets/logos/Figma-logo.svg';

// skills are imported from src/data/skills
---

<!doctype html>
<html lang="en" data-theme="dark" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <!-- JSON-LD: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Site Author',
      url: new URL('/', Astro.site).toString(),
      logo: new URL('/hasac/favicon.svg', Astro.site).toString(),
      sameAs: [
        'https://x.com/guihubie',
        'https://www.linkedin.com/in/guilherme-hubie/',
      ],
    })} />
	</head>
	<body>
		<Header />
		<main>
      <HeroSection
        title="Ağılı Ev Sizin Üçün Olsun"
        subtitle=""
        showCTA
        primaryCTA={{ text: 'View Projects', href: '/hasac/portfolio' }}
        secondaryCTA={{ text: 'Read Blog', href: '/hasac/blog' }}
      />
     

    <section class="py-6">
      <ArrowSeparator />
      <SkillsSection title="Skills & Tools" skills={skills} />   
      <ArrowSeparator />
      <WorkExperience title="Work Experience" items={work} />
      <ArrowSeparator />
      <Studies title="Studies" items={studies} />
      <GlowLineSeparator />
    </section>
		</main>
		<Footer />
	</body>
</html>
